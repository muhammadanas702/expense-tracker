# Local secrets. The deployment workflow creates production copies from Actions secrets.
/config/db.local.php
/config/mail.local.php
/.env
/.env.*
!/.env.example

# Local database dumps, archives, and generated user data.
*.sql
!/schema.sql
*.sql.gz
*.bak
*.backup
*.zip
/storage/*
!/storage/.gitkeep
!/storage/.htaccess
/.ftp-deploy-sync-state.json

# Local diagnostics and one-time admin maintenance scripts.
/phpinfo.php

# SQL files for manual import are meant to be kept
!database/*.sql
