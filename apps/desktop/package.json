{
  "name": "expenseflow-desktop",
  "productName": "ExpenseFlow",
  "version": "1.0.0",
  "description": "ExpenseFlow for Windows",
  "main": "main.js",
  "author": "ExpenseFlow",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "pk.expenseflow.desktop",
    "productName": "ExpenseFlow",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "package.json",
      "build/icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "ExpenseFlow-Setup.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "ExpenseFlow"
    },
    "appx": {
      "applicationId": "ExpenseFlow",
      "identityName": "55408MuhammadAnas.ExpenseFlow-MoneyManager",
      "publisher": "CN=BD6A12CC-89FA-40A3-8A17-F92091A0CCD3",
      "publisherDisplayName": "Muhammad_Anas",
      "displayName": "ExpenseFlow",
      "backgroundColor": "transparent",
      "languages": [
        "en-US"
      ],
      "artifactName": "ExpenseFlow-Store.msix"
    }
  }
}